# AWS region for Bedrock
AWS_REGION=us-east-1

# Bedrock model — cross-region inference prefix required
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Ollama model (offline fallback)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://ollama:11434

# Which LLM backend: bedrock | ollama
LLM_PROVIDER=bedrock

# DB reset interval in seconds (demo: 300 = 5 min)
DB_RESET_INTERVAL=300

# NOTE: Do NOT set AWS_PROFILE — use EC2 instance role (IMDS) or env credentials

# --- Summit 2.0 / Act 4 only — Trend Vision One AI Guard (optional) ---
# Omit these and Act 4 fails closed (every call blocked, no crash).
# V1_API_KEY=<your Trend Vision One API key, a JWT>
# V1_REGION=sg
# V1_APP_NAME=pretty-please
