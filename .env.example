# AWS region for Bedrock
AWS_REGION=us-east-1

# Bedrock model — cross-region inference prefix required
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Ollama model (offline fallback)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_HOST=http://ollama:11434

# Which LLM backend: bedrock | ollama
LLM_PROVIDER=bedrock

# DB reset interval in seconds (demo: 300 = 5 min)
DB_RESET_INTERVAL=300

# NOTE: Do NOT set AWS_PROFILE — use EC2 instance role (IMDS) or env credentials
